rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Catch-all: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'diyanto13@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Helper Validasi Akun Wali Kelas / Guru
    function isValidTeacher(data) {
      return data.keys().hasAll(['nip', 'nama', 'role', 'assignedKelas', 'kelasId']) &&
        data.nip is string && data.nip.size() <= 30 &&
        data.nama is string && data.nama.size() <= 100 &&
        (data.role == 'wali_kelas' || data.role == 'kurikulum' || data.role == 'admin') &&
        data.assignedKelas is string && data.assignedKelas.size() <= 50 &&
        data.kelasId is string && data.kelasId.size() <= 50 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
        (!('noHp' in data) || (data.noHp is string && data.noHp.size() <= 25)) &&
        (!('password' in data) || (data.password is string && data.password.size() <= 50));
    }

    // Helper Validasi Akun Super Admin
    function isValidSuperAdminConfig(data) {
      return data.keys().hasAll(['email', 'nama', 'nip']) &&
        data.email is string && data.email.size() <= 100 &&
        data.nama is string && data.nama.size() <= 100 &&
        data.nip is string && data.nip.size() <= 50 &&
        (!('noHp' in data) || (data.noHp is string && data.noHp.size() <= 25)) &&
        (!('password' in data) || (data.password is string && data.password.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 100));
    }

    // Helper Validasi Entitas Siswa
    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'nis', 'nama', 'jenisKelamin', 'noHpOrtu']) &&
        data.id is string && data.id.size() <= 64 &&
        data.nis is string && data.nis.size() <= 20 &&
        data.nama is string && data.nama.size() > 0 && data.nama.size() <= 100 &&
        (data.jenisKelamin == 'L' || data.jenisKelamin == 'P') &&
        data.noHpOrtu is string && data.noHpOrtu.size() <= 30 &&
        (!('kelasId' in data) || (data.kelasId is string && data.kelasId.size() <= 50)) &&
        (!('alamat' in data) || (data.alamat is string && data.alamat.size() <= 250)) &&
        (!('catatan' in data) || (data.catatan is string && data.catatan.size() <= 250));
    }

    // Helper Validasi Entitas Absensi Harian
    function isValidAttendance(data, dateId) {
      return data.keys().hasAll(['date', 'records', 'updatedAt']) &&
        data.date is string &&
        data.records is map &&
        data.updatedAt is string &&
        (!('kelasId' in data) || (data.kelasId is string && data.kelasId.size() <= 50)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 100));
    }

    // Helper Validasi Konfigurasi Rombel
    function isValidConfig(data) {
      return data.keys().hasAll(['namaSekolah', 'kelas', 'waliKelas', 'tahunAjaran']) &&
        data.namaSekolah is string && data.namaSekolah.size() <= 120 &&
        data.kelas is string && data.kelas.size() <= 50 &&
        data.waliKelas is string && data.waliKelas.size() <= 100 &&
        data.tahunAjaran is string && data.tahunAjaran.size() <= 20 &&
        (!('programKeahlian' in data) || (data.programKeahlian is string && data.programKeahlian.size() <= 100)) &&
        (!('semester' in data) || (data.semester == 'Ganjil' || data.semester == 'Genap'));
    }

    // Koleksi Master Data Akun Wali Kelas
    match /wali_kelas/{teacherId} {
      allow read: if true;
      allow create, update: if isValidId(teacherId) && isValidTeacher(incoming());
      allow delete: if isValidId(teacherId);
    }

    // Koleksi Master Data Siswa
    match /siswa/{studentId} {
      allow read: if true;
      allow create: if isValidId(studentId) && isValidStudent(incoming());
      allow update: if isValidId(studentId) && isValidStudent(incoming());
      allow delete: if isValidId(studentId);
    }

    // Koleksi Absensi Harian Berdasarkan Tanggal
    match /absensi/{date} {
      allow read: if true;
      allow create: if isValidId(date) && isValidAttendance(incoming(), date);
      allow update: if isValidId(date) && isValidAttendance(incoming(), date);
      allow delete: if isValidId(date);
    }

    // Koleksi Konfigurasi Rombel & Sekolah & Super Admin
    match /pengaturan/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) && (isValidConfig(incoming()) || isValidSuperAdminConfig(incoming()));
      allow delete: if isSuperAdmin();
    }
  }
}
