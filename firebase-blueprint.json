{
  "entities": {
    "Teacher": {
      "title": "Teacher",
      "description": "Profil guru dan wali kelas SMKS PGRI 1 Kota Sukabumi",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik guru atau NIP",
          "maxLength": 64
        },
        "nip": {
          "type": "string",
          "description": "Nomor Induk Pegawai / NUPTK",
          "maxLength": 30
        },
        "nama": {
          "type": "string",
          "description": "Nama lengkap beserta gelar",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Alamat email guru",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["wali_kelas", "kurikulum", "admin"],
          "description": "Peran pengguna dalam sistem presensi"
        },
        "assignedKelas": {
          "type": "string",
          "description": "Nama kelas yang diampu",
          "maxLength": 50
        },
        "kelasId": {
          "type": "string",
          "description": "Slug ID rombel",
          "maxLength": 50
        },
        "noHp": {
          "type": "string",
          "description": "Nomor WhatsApp guru",
          "maxLength": 25
        },
        "password": {
          "type": "string",
          "description": "Kata sandi khusus guru",
          "maxLength": 50
        }
      },
      "required": ["nip", "nama", "role", "assignedKelas", "kelasId"]
    },
    "SuperAdminConfig": {
      "title": "SuperAdminConfig",
      "description": "Konfigurasi akun Super Admin sistem presensi",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email resmi Super Admin",
          "maxLength": 100
        },
        "nama": {
          "type": "string",
          "description": "Nama lengkap Super Admin / Kurikulum",
          "maxLength": 100
        },
        "nip": {
          "type": "string",
          "description": "NIP Super Admin",
          "maxLength": 50
        },
        "noHp": {
          "type": "string",
          "description": "Nomor WhatsApp",
          "maxLength": 25
        },
        "password": {
          "type": "string",
          "description": "Kata sandi Super Admin",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan"
        },
        "updatedBy": {
          "type": "string",
          "description": "Nama pengubah"
        }
      },
      "required": ["email", "nama", "nip"]
    },
    "Student": {
      "title": "Student",
      "description": "Data peserta didik di SMKS PGRI 1 Kota Sukabumi",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik siswa",
          "maxLength": 64
        },
        "nis": {
          "type": "string",
          "description": "Nomor Induk Siswa",
          "maxLength": 20
        },
        "nama": {
          "type": "string",
          "description": "Nama lengkap siswa",
          "maxLength": 100
        },
        "jenisKelamin": {
          "type": "string",
          "enum": ["L", "P"],
          "description": "Jenis kelamin L atau P"
        },
        "noHpOrtu": {
          "type": "string",
          "description": "Nomor telepon / WhatsApp orang tua siswa",
          "maxLength": 25
        },
        "alamat": {
          "type": "string",
          "description": "Domisili atau alamat siswa",
          "maxLength": 250
        },
        "catatan": {
          "type": "string",
          "description": "Catatan khusus atau prestasi siswa",
          "maxLength": 250
        },
        "kelasId": {
          "type": "string",
          "description": "ID Rombel / Kelas siswa",
          "maxLength": 50
        }
      },
      "required": ["id", "nis", "nama", "jenisKelamin", "noHpOrtu"]
    },
    "DailyAttendance": {
      "title": "DailyAttendance",
      "description": "Catatan kehadiran harian peserta didik",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "Tanggal presensi YYYY-MM-DD",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "records": {
          "type": "object",
          "description": "Peta catatan absensi per siswa"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan ISO string"
        },
        "updatedBy": {
          "type": "string",
          "description": "Nama pengisi absensi / wali kelas",
          "maxLength": 100
        },
        "kelasId": {
          "type": "string",
          "description": "ID Rombel / Kelas",
          "maxLength": 50
        }
      },
      "required": ["date", "records", "updatedAt"]
    },
    "ClassConfig": {
      "title": "ClassConfig",
      "description": "Identitas kelas dan sekolah untuk kop surat",
      "type": "object",
      "properties": {
        "namaSekolah": {
          "type": "string",
          "maxLength": 120
        },
        "programKeahlian": {
          "type": "string",
          "maxLength": 100
        },
        "kelas": {
          "type": "string",
          "maxLength": 50
        },
        "waliKelas": {
          "type": "string",
          "maxLength": 100
        },
        "nipWaliKelas": {
          "type": "string",
          "maxLength": 50
        },
        "kepalaSekolah": {
          "type": "string",
          "maxLength": 100
        },
        "nipKepalaSekolah": {
          "type": "string",
          "maxLength": 50
        },
        "tahunAjaran": {
          "type": "string",
          "maxLength": 20
        },
        "semester": {
          "type": "string",
          "enum": ["Ganjil", "Genap"]
        },
        "alamatSekolah": {
          "type": "string",
          "maxLength": 250
        }
      },
      "required": ["namaSekolah", "kelas", "waliKelas", "tahunAjaran"]
    }
  },
  "firestore": {
    "/wali_kelas/{teacherId}": {
      "schema": "Teacher",
      "description": "Koleksi data master akun wali kelas dan pengajar"
    },
    "/siswa/{studentId}": {
      "schema": "Student",
      "description": "Koleksi data master peserta didik"
    },
    "/absensi/{date}": {
      "schema": "DailyAttendance",
      "description": "Koleksi presensi harian per tanggal"
    },
    "/pengaturan/{configId}": {
      "schema": "ClassConfig",
      "description": "Konfigurasi identitas kelas dan sekolah atau superadmin"
    }
  }
}
